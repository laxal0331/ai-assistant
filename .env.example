DEEPGRAM_API_KEY=xxx
DEEPSEEK_API_KEY=xxx
DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-v4-flash 默认关闭思考模式（更快、避免空回复）；V4 Pro 不受影响
# LLM_MAX_TOKENS=400

# Legacy: Cerebras provider code is kept, but it is not used by default.
# CEREBRAS_API_KEY=xxx
# CEREBRAS_MODEL=llama3.1-8b

# 阿里云 OCR 统一识别（RecognizeAllText / MultiLang，支持中/英/日）
# ALIBABA_CLOUD_ACCESS_KEY_ID=xxx
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=xxx
# ALIYUN_OCR_ENDPOINT=ocr-api.cn-hangzhou.aliyuncs.com

# 桌面版首次运行会在用户目录生成 .env，可从托盘「打开配置目录」编辑

# 语音转写岗位词库（默认 backend；设置页可切换，以 localStorage 为准）
# STT_VOCAB_PROFILE=backend
# STT_EXTRA_KEYTERMS=公司内部产品名,项目代号
# STT_KEYTERM_LIMIT=65

# 提问次数（文字 1 次；截图/图片 2 次；勾选参考资料上下文时翻倍；LLM 成功后才扣）
# USAGE_QUOTA_ENABLED=1
# USAGE_DEFAULT_CREDITS=20
# RECHARGE_SECRET=请改成只有你知道的随机长字符串

# 企业微信智能机器人（API 长连接，无需公网域名；见 docs/wecom-bot-setup.md）
# WECOM_BOT_ENABLED=1
# WECOM_BOT_ID=
# WECOM_BOT_SECRET=
# WECOM_BOT_WS_URL=wss://openws.work.weixin.qq.com

# Qwen vision: desktop screenshots are sent directly to Qwen-VL instead of OCR.
# DASHSCOPE_API_KEY=xxx
# QWEN_VL_MODEL=qwen3-vl-flash
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

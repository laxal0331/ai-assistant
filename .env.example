DEEPGRAM_API_KEY=xxx
CEREBRAS_API_KEY=xxx

# 备用 / 国内直连 LLM（Cerebras 失败时自动切换）
DEEPSEEK_API_KEY=xxx
DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-v4-flash 默认关闭思考模式（更快、避免空回复）；V4 Pro 不受影响
# LLM_MAX_TOKENS=400

# 阿里云 OCR 统一识别（RecognizeAllText / MultiLang，支持中/英/日）
# ALIBABA_CLOUD_ACCESS_KEY_ID=xxx
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=xxx
# ALIYUN_OCR_ENDPOINT=ocr-api.cn-hangzhou.aliyuncs.com

# 桌面版首次运行会在用户目录生成 .env，可从托盘「打开配置目录」编辑

# 提问次数（LLM 成功后才扣；勾选参考资料上下文时扣 2 次）
# USAGE_QUOTA_ENABLED=1
# USAGE_DEFAULT_CREDITS=20
# RECHARGE_SECRET=请改成只有你知道的随机长字符串
